{
  "name": "pptx-peek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opens .pptx files in the browser and exports embedded images byte-for-byte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piecioshka/pptx-peek.git"
  },
  "homepage": "https://piecioshka.github.io/pptx-peek/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @screenshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "node --experimental-strip-types scripts/make-e2e-fixtures.ts",
    "prepare": "husky",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "overrides": {
    "eslint-config-piecioshka": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-piecioshka": "^3.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
